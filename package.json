    "build:fallback": "node scripts/build-fallback-site.mjs",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@moonshot-ai/kimi-code": "^0.41.0",
    "@upstash/redis": "^1.38.3"
  }
