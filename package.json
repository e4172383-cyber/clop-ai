{
  "name": "clop-ai",
  "version": "1.0.0",
  "private": true,
  "description": "Clop ai - Telegram AI bot (Claude 5) + local usage dashboard",
  "type": "module",
  "main": "index.js",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "node index.js",
