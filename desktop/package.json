{
  "name": "clop-code",
  "version": "2.4.4",
  "productName": "Clop Code",
  "description": "Clop Code — AI workspace for Windows and Linux with Telegram sign-in",
  "author": "Clop",
  "license": "UNLICENSED",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "dist": "node scripts/icon.cjs && electron-builder --win nsis --x64",
    "dist:linux": "node scripts/icon.cjs && electron-builder --linux tar.xz --x64",
    "pack": "node scripts/icon.cjs && electron-builder --dir --win --x64"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.clop.code.desktop",
    "productName": "Clop Code",
    "artifactName": "Clop-Code-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json",
      "TERMS.txt"
    ],
    "asar": true,
    "afterPack": "scripts/after-pack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "linux": {
      "target": [
        "tar.xz"
      ],
      "category": "Development",
      "icon": "build/icon.png",
      "executableName": "clop-code",
      "artifactName": "Clop-Code-${version}-linux-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Clop Code",
      "runAfterFinish": false,
      "license": "TERMS.txt",
      "deleteAppDataOnUninstall": false
    }
  }
}
